import java.util.*;
public class Main{
    public static void main(String args[]){
        Scanner s=new Scanner(System.in);
        int n=s.nextInt();
        int a[]=new int[n+1];
        for(int i=1;i<=n;i++){
            a[i]=s.nextInt();
        }
        int sc=0;
        int ec=0;
        for(int i=1;i<=n;i++){
        if(i==a[i]){
            sc++;
        }
        else if(i==a[a[i]]){
            ec++;
        }
        }
        System.out.println((ec/2)+(1L*sc*(sc-1)/2));
    }
}
