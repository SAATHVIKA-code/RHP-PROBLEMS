class Solution {
    public int bfs(int [][] grid,int fo,int row,int col){
        Queue<int[]> q=new LinkedList<>();
        int nd=0;
        int dr[]={0,0,-1,1};
        int dc[]={-1,1,0,0};
        for(int i=0;i<grid.length;i++){
            for(int j=0;j<grid[0].length;j++){
        if(grid[i][j]==2){
            q.add(new int[]{i,j});
        }
            }
        }
        while((!q.isEmpty())&&fo>0){
            nd++;
            int qsize=q.size();
            while(qsize-->0){
                int cell[]=q.poll();
                int cr=cell[0];
                int cc=cell[1];
                for(int i=0;i<4;i++){
                    int nr=cr+dr[i];
                    int nc=cc+dc[i];
                    if(nr>=0&&nr<grid.length&&nc>=0&&nc<grid[0].length&&grid[nr][nc]==1){
                        grid[nr][nc]=2;
                        q.add(new int[]{nr,nc});
                        fo--;
                    }
                }
            }
        }
        boolean found=false;
        for(int i=0;i<grid.length;i++){
            for(int j=0;j<grid[0].length;j++){
                if(grid[i][j]==1){
                    found=true;
                    return -1;
                }
            }
        }
        
            return nd;
        
    }
    public int orangesRotting(int[][] grid) {
        int fo=0;
        for(int i=0;i<grid.length;i++){
            for(int j=0;j<grid[0].length;j++){
                if(grid[i][j]==1){
                    fo++;
                }
            }
        }
        
                  return bfs(grid,fo,0,0);
                }
        
        
    }
